# ─── Astro Frontend (apps/web) ───────────────────────────────────────────────
SITE_URL=https://www.desk365.io
PAYLOAD_API_URL=https://cms.desk365.io
PAYLOAD_SECRET=change-me-32-chars-minimum

# GTM / Analytics
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_COOKIEYES_ID=your-cookieyes-id
PUBLIC_CALENDLY_URL=https://calendly.com/desk365/demo

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL_TO=support@desk365.io

# ─── Payload CMS (apps/cms) ──────────────────────────────────────────────────
DATABASE_URI=postgresql://user:password@host:5432/desk365
PAYLOAD_SECRET=change-me-32-chars-minimum
CORS_URLS=https://www.desk365.io,http://localhost:4321
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Storage (optional – S3 compatible for media uploads)
S3_BUCKET=desk365-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
