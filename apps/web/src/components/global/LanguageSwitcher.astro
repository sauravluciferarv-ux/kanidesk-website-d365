---
const pathname = Astro.url.pathname

const locales = [
  { code: 'en', label: 'English', flag: '🇺🇸' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪' },
  { code: 'fr', label: 'Français', flag: '🇫🇷' },
  { code: 'es', label: 'Español', flag: '🇪🇸' },
]

function getLocaleHref(code: string) {
  return code === 'en' ? '/' : `/${code}/`
}

// Detect active locale from pathname
const activeCode = locales.find(l => l.code !== 'en' && pathname.startsWith(`/${l.code}`))?.code ?? 'en'
const active = locales.find(l => l.code === activeCode)!
---

<div class="lang-switcher" id="langSwitcher">
  <button class="lang-switcher-btn" id="langSwitcherBtn" aria-haspopup="listbox" aria-expanded="false">
    <span aria-hidden="true">{active.flag}</span>
    {active.label}
    <i class="fas fa-angle-down chevron"></i>
  </button>

  <div class="lang-switcher-dropdown" id="langSwitcherDropdown" role="listbox">
    {locales.map(({ code, label, flag }) => (
      <a
        href={getLocaleHref(code)}
        class={code === activeCode ? 'active' : ''}
        role="option"
        aria-selected={code === activeCode}
      >
        <span aria-hidden="true">{flag}</span>
        {label}
      </a>
    ))}
  </div>
</div>

<script>
  const btn = document.getElementById('langSwitcherBtn')
  const dropdown = document.getElementById('langSwitcherDropdown')

  if (btn && dropdown) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = dropdown.classList.contains('open')
      dropdown.classList.toggle('open', !isOpen)
      btn.classList.toggle('open', !isOpen)
      btn.setAttribute('aria-expanded', String(!isOpen))
    })

    document.addEventListener('click', () => {
      dropdown.classList.remove('open')
      btn.classList.remove('open')
      btn.setAttribute('aria-expanded', 'false')
    })
  }
</script>
