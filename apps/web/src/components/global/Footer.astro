<style>
/* ─── Variables ───────────────────────── */
:root {
  --blue-text: #282c81;
  --blue-dark: #1e2254;
  --blue-darker: #131536;
  --green: #82B212;
  --text-gray: #a1a5b7;
}

/* ─── Top CTA Banner ──────────────────── */
.d365-cta-banner {
  background: linear-gradient(135deg, #f5f7ff 0%, #ffffff 100%);
  padding: 60px 24px;
  border-top: 1px solid #e5e7eb;
}
.cta-banner-content {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  border-radius: 20px;
}
.cta-text {
  max-width: 500px;
  z-index: 2;
}
.cta-text h2 {
  font-size: 36px;
  font-weight: 700;
  color: var(--blue-text);
  margin: 0 0 16px 0;
  line-height: 1.2;
}
.cta-text p {
  font-size: 18px;
  color: #4b5563;
  margin: 0 0 32px 0;
}
.cta-buttons {
  display: flex;
  align-items: center;
  gap: 24px;
}
.btn-trial {
  padding: 14px 28px;
  background: var(--green);
  color: white;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s;
}
.btn-trial:hover {
  background: #6a9410;
}
.btn-demo-link {
  color: var(--green);
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 6px;
}
.btn-demo-link:hover {
  text-decoration: underline;
}
.cta-graphic {
  position: absolute;
  right: -50px;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.1;
  z-index: 1;
  width: 400px;
  height: 400px;
}

/* ─── Dark Footer ─────────────────────── */
.d365-footer-main {
  background: var(--blue-dark);
  color: white;
  padding: 80px 24px 40px;
  font-family: 'Inter', 'Roboto', sans-serif;
}
.d365-footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  gap: 80px;
  justify-content: space-between;
  flex-wrap: wrap;
}

/* Left Column */
.footer-left {
  flex: 1;
  min-width: 250px;
  max-width: 300px;
}
.footer-logo img {
  height: 40px;
  width: auto;
  margin-bottom: 24px;
}
.footer-address {
  font-style: normal;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-gray);
  margin-bottom: 24px;
}
.footer-address strong {
  color: white;
  font-weight: 500;
}
.footer-social {
  display: flex;
  gap: 16px;
}
.footer-social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
  color: white;
  transition: background 0.2s;
}
.footer-social a:hover {
  background: var(--green);
}

/* Links Grid */
.footer-links-grid {
  flex: 3;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}
.footer-col h4 {
  font-size: 16px;
  font-weight: 600;
  color: white;
  margin: 0 0 24px 0;
}
.footer-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.footer-col a {
  color: var(--text-gray);
  text-decoration: none;
  font-size: 14px;
  transition: color 0.2s;
}
.footer-col a:hover {
  color: white;
}

/* Bottom Bar */
.footer-bottom {
  max-width: 1200px;
  margin: 60px auto 0;
  padding-top: 32px;
  border-top: 1px solid rgba(255,255,255,0.1);
}
.footer-bottom-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}
.footer-bottom-left p {
  color: var(--text-gray);
  font-size: 14px;
  margin: 0;
}
.footer-badges {
  display: flex;
  align-items: center;
  gap: 16px;
}
.footer-badges img {
  height: 40px;
  width: auto;
  opacity: 0.8;
  transition: opacity 0.2s;
}
.footer-badges img:hover {
  opacity: 1;
}

/* Responsive */
@media (max-width: 1024px) {
  .cta-banner-content { flex-direction: column; text-align: center; }
  .cta-buttons { justify-content: center; }
  .cta-graphic { display: none; }
  .d365-footer-inner { gap: 40px; }
  .footer-links-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .footer-links-grid { grid-template-columns: 1fr; }
  .footer-bottom-inner { flex-direction: column; text-align: center; }
  .footer-badges { justify-content: center; }
}
</style>
