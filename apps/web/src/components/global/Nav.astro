---
interface NavItem {
  label: string
  href: string
  children?: { label: string; href: string }[]
}
interface Props { items: NavItem[] }
const { items } = Astro.props
const current = Astro.url.pathname
---

<nav class="hidden sm:flex items-center gap-1" aria-label="Main navigation">
  {items.map((item) => (
    <div class="relative group">
      <a
        href={item.href}
        class:list={[
          'px-3 py-2 rounded-md text-sm font-medium transition-colors',
          current.startsWith(item.href) && item.href !== '/'
            ? 'text-brand-700 bg-brand-50'
            : 'text-gray-700 hover:text-brand-700 hover:bg-gray-50'
        ]}
        aria-current={current === item.href ? 'page' : undefined}
      >
        {item.label}
        {item.children && (
          <svg class="inline ml-1 w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        )}
      </a>

      {item.children && (
        <div class="absolute top-full left-0 mt-1 w-48 bg-white rounded-lg shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 p-1">
          {item.children.map((child) => (
            <a
              href={child.href}
              class="block px-3 py-2 text-sm text-gray-700 rounded-md hover:bg-gray-50 hover:text-brand-700"
            >
              {child.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}
</nav>
