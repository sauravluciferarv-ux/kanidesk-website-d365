<script>
  // Simplified logic to handle dropdowns and mobile menu from the imported HTML
  document.addEventListener('DOMContentLoaded', () => {
    const btnFeatures = document.getElementById('btnFeatures');
    const btnSolutions = document.getElementById('btnSolutions');
    const btnResources = document.getElementById('btnResources');
    const popupFeatures = document.getElementById('popupFeatures');
    const popupSolutions = document.getElementById('popupSolutions');
    const popupResources = document.getElementById('popupResources');
    const ddOverlay = document.getElementById('ddOverlay');
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileNav = document.getElementById('mobileNav');

    const menus = [
      { btn: btnFeatures, popup: popupFeatures },
      { btn: btnSolutions, popup: popupSolutions },
      { btn: btnResources, popup: popupResources }
    ];

    function closeAll() {
      menus.forEach(m => {
        if(m.btn) m.btn.classList.remove('open');
        if(m.popup) m.popup.classList.remove('open');
      });
      if(ddOverlay) ddOverlay.classList.remove('open');
    }

    menus.forEach(m => {
      if (m.btn && m.popup) {
        m.btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = m.popup.classList.contains('open');
          closeAll();
          if (!isOpen) {
            m.btn.classList.add('open');
            m.popup.classList.add('open');
            if(ddOverlay) ddOverlay.classList.add('open');
          }
        });
      }
    });

    if (ddOverlay) {
      ddOverlay.addEventListener('click', closeAll);
    }
    
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.header-nav') && !e.target.closest('.nav-dropdown-popup')) {
        closeAll();
      }
    });

    if (mobileMenuBtn && mobileNav) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileNav.classList.toggle('open');
      });
    }
  });
</script>
