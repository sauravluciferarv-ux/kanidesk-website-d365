---
import type { Logo } from '@/lib/payload'

interface Props {
  logos: Logo[]
  label?: string
}

const { logos, label = 'Trusted by 5,000+ companies worldwide' } = Astro.props
const doubled = [...logos, ...logos]
---

<section class="py-12 bg-gray-50 overflow-hidden" aria-label={label}>
  <div class="container text-center mb-8">
    <p class="text-sm font-medium text-gray-500 uppercase tracking-widest">{label}</p>
  </div>

  <div class="relative">
    <!-- fade edges -->
    <div class="absolute left-0 top-0 w-24 h-full bg-gradient-to-r from-gray-50 z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 w-24 h-full bg-gradient-to-l from-gray-50 z-10 pointer-events-none"></div>

    <div class="flex overflow-hidden" aria-hidden="true">
      <div class="carousel__track">
        {doubled.map((logo) => (
          <div class="flex items-center justify-center w-32 h-12 shrink-0">
            <img
              src={logo.image.url}
              alt={logo.name}
              width="120"
              height="40"
              class="max-h-8 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
