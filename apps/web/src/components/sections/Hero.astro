---
interface Props {
  headline: string
  subheadline: string
  primaryCTA: { label: string; href: string }
  secondaryCTA?: { label: string; href: string }
  image?: { url: string; alt: string; width: number; height: number }
  badge?: string
}

const { headline, subheadline, primaryCTA, secondaryCTA, image, badge } = Astro.props
---

<section class="section bg-gradient-to-b from-brand-50 to-white overflow-hidden">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div class="text-center lg:text-left">
        {badge && (
          <span class="badge bg-brand-100 text-brand-700 mb-4">
            {badge}
          </span>
        )}
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight mb-6">
          {headline}
        </h1>
        <p class="text-xl text-gray-500 mb-8 max-w-lg mx-auto lg:mx-0">
          {subheadline}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a href={primaryCTA.href} class="btn-primary text-base px-6 py-3">
            {primaryCTA.label}
          </a>
          {secondaryCTA && (
            <a href={secondaryCTA.href} class="btn-secondary text-base px-6 py-3">
              {secondaryCTA.label}
            </a>
          )}
        </div>
        <p class="mt-4 text-sm text-gray-400">No credit card required · Free 21-day trial</p>
      </div>

      <!-- Image -->
      {image && (
        <div class="relative">
          <div class="absolute inset-0 bg-brand-100 rounded-2xl transform rotate-2"></div>
          <img
            src={image.url}
            alt={image.alt}
            width={image.width}
            height={image.height}
            class="relative rounded-2xl shadow-2xl w-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
    </div>
  </div>
</section>
