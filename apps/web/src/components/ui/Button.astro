---
interface Props {
  href?: string
  variant?: 'primary' | 'secondary' | 'ghost'
  size?: 'sm' | 'md' | 'lg'
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  class?: string
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  class: className = ''
} = Astro.props

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost'
}[variant]

const sizeClass = {
  sm: 'text-sm px-3 py-1.5',
  md: 'text-sm px-5 py-2.5',
  lg: 'text-base px-6 py-3'
}[size]
---

{href ? (
  <a href={href} class:list={['btn', variantClass, sizeClass, className]}>
    <slot />
  </a>
) : (
  <button type={type} disabled={disabled} class:list={['btn', variantClass, sizeClass, className, disabled && 'opacity-50 cursor-not-allowed']}>
    <slot />
  </button>
)}
