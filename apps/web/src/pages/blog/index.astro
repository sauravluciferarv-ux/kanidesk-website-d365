---
import PageLayout from '@/layouts/PageLayout.astro'
import Card from '@/components/ui/Card.astro'
import { getPosts } from '@/lib/payload'
import { breadcrumbSchema } from '@/lib/schema'

const page = Number(Astro.url.searchParams.get('page') ?? 1)
const { docs: posts, totalPages } = await getPosts(page, 12).catch(() => ({ docs: [], totalPages: 1 }))

const SITE_URL = import.meta.env.SITE_URL || 'https://www.desk365.io'
const schema = breadcrumbSchema([
  { name: 'Home', url: SITE_URL },
  { name: 'Blog', url: `${SITE_URL}/blog` }
])
---

<PageLayout
  title="Blog — Desk365 Support Insights"
  description="Tips, guides, and best practices for customer support teams. Learn how to deliver exceptional support with Desk365."
  canonical={`${SITE_URL}/blog`}
  schema={schema}
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }]}
>
  <section class="section bg-white">
    <div class="container">
      <div class="mb-12">
        <h1 class="text-4xl font-extrabold text-gray-900 mb-3">Blog</h1>
        <p class="text-lg text-gray-500">Insights and guides for modern support teams.</p>
      </div>

      {posts.length === 0 ? (
        <p class="text-gray-500">No posts yet — check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <Card href={`/blog/${post.slug}`} class="flex flex-col">
              {post.coverImage && (
                <img
                  src={post.coverImage.url}
                  alt={post.coverImage.alt}
                  width={600} height={340}
                  class="w-full aspect-video object-cover rounded-lg mb-4"
                  loading="lazy"
                />
              )}
              <time datetime={post.publishedAt} class="text-xs text-gray-400 mb-2">
                {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-brand-600 transition-colors">
                {post.title}
              </h2>
              {post.excerpt && (
                <p class="text-sm text-gray-500 leading-relaxed line-clamp-3">{post.excerpt}</p>
              )}
            </Card>
          ))}
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="flex justify-center gap-2 mt-12">
          {page > 1 && (
            <a href={`/blog?page=${page - 1}`} class="btn-secondary">← Previous</a>
          )}
          <span class="px-4 py-2 text-sm text-gray-500">Page {page} of {totalPages}</span>
          {page < totalPages && (
            <a href={`/blog?page=${page + 1}`} class="btn-secondary">Next →</a>
          )}
        </div>
      )}
    </div>
  </section>
</PageLayout>
