---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import LogoCarousel from '@/components/sections/LogoCarousel.astro'
import FeatureGrid from '@/components/sections/FeatureGrid.astro'
import CTA from '@/components/sections/CTA.astro'
import { getLogos } from '@/lib/payload'
import { buildHreflangLinks } from '@/lib/seo'

export const getStaticPaths = () => {
  return ['de', 'fr', 'es'].map((lang) => ({ params: { lang } }))
}

const { lang } = Astro.params
const SITE_URL = import.meta.env.SITE_URL || 'https://www.desk365.io'

// Load translation dynamically
let t: Record<string, Record<string, string>> = {}
try {
  const mod = await import(`../../i18n/${lang}.json`)
  t = mod.default
} catch {
  t = {}
}

const logos = await getLogos().then(r => r.docs).catch(() => [])
const hreflangLinks = buildHreflangLinks('/')

const features = [
  { title: t.features?.inbox ?? 'Shared Inbox', description: t.features?.inboxDesc ?? 'Manage all tickets in one unified workspace.', icon: '📬' },
  { title: t.features?.auto  ?? 'Automation',   description: t.features?.autoDesc  ?? 'Auto-assign and respond without manual effort.', icon: '⚡' },
  { title: t.features?.kb    ?? 'Knowledge Base',description: t.features?.kbDesc   ?? 'Self-service portal that deflects tickets.', icon: '📚' }
]
---

<BaseLayout
  title={t.home?.title ?? `Desk365 — Helpdesk Software`}
  description={t.home?.description ?? 'Modern helpdesk and ticketing system for growing teams.'}
  canonical={`${SITE_URL}/${lang}/`}
  lang={lang}
  hreflangLinks={hreflangLinks}
>
  <Hero
    headline={t.home?.headline ?? 'Support that feels personal, scales effortlessly'}
    subheadline={t.home?.subheadline ?? 'Desk365 brings email, chat, and tickets into one workspace.'}
    primaryCTA={{ label: t.home?.cta ?? 'Start free trial', href: '/request-demo' }}
  />

  {logos.length > 0 && <LogoCarousel logos={logos} label={t.home?.logoLabel} />}

  <FeatureGrid features={features} />

  <CTA
    title={t.cta?.title}
    description={t.cta?.description}
  />
</BaseLayout>
